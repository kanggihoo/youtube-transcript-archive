# 복사해서 .env로 쓰세요. .env는 커밋되지 않습니다.
#
# Google Cloud Console > 사용자 인증 정보 > API 키
# 만든 뒤 "API 제한"을 YouTube Data API v3 하나로 좁히세요.
YOUTUBE_API_KEY=

# 처리할 재생목록. https://www.youtube.com/playlist?list=PLxxxx 의 PLxxxx 부분입니다.
# 전체 URL을 그대로 넣어도 됩니다.
# 공개 범위는 공개 또는 일부 공개여야 합니다. 비공개는 API 키로 안 읽힙니다.
# "나중에 볼 동영상"(WL)은 2016년부터 API로 막혀서 빈 목록이 옵니다.
YOUTUBE_PLAYLIST_ID=

# 아래는 --clean(받은 뒤 재생목록에서 삭제)을 쓸 때만 필요합니다.
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID > 애플리케이션 유형: 데스크톱 앱
# OAuth 동의 화면의 게시 상태를 "프로덕션"으로 두세요.
# Testing이면 refresh token이 7일마다 만료됩니다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# node --env-file=.env auth.mjs 로 발급받아 붙여넣으세요. 한 번만 하면 됩니다.
YOUTUBE_REFRESH_TOKEN=
